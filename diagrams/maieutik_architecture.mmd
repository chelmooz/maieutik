    classDef interface fill:#3b82f6,stroke:#1e40af,color:#fff,stroke-width:2px
    classDef core fill:#60a5fa,stroke:#1d4ed8,color:#000
    classDef system1 fill:#a78bfa,stroke:#7c3aed,color:#fff
    classDef cpp fill:#facc15,stroke:#eab308,color:#000
    classDef external fill:#34d399,stroke:#16a34a,color:#000
    
    class I1,I2,I3 interface
    class C1,C2,C3,C4 core
    class S1,S2,S3,S4 system1
    class F1,F2,F3,F4 cpp
    class E1,E2,E3 external
