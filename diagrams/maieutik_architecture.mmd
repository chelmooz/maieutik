%% Diagramme Architecture Maieutik-Corrige
%% Roadmap et composants principaux

%%{init: {'theme':'dark','themeVariables':{'primaryColor':'#1e40af','primaryTextColor':'#ffffff','secondaryColor':'#334155'}}%%

flowchart TB
    subgraph "Niveau 1: Interfaces"
        I1[CLI<br/>cargo run]
        I2[MCP Server<br/>stdio/JSON-RPC]
        I3[UI Frontend<br/>egui/eframe]
    end

    subgraph "Niveau 2: Core Modules"
        C1[Index Engine<br/>BM25 + HNSW + RRF]
        C2[Vector Store<br/>sled + embeddings]
        C3[Search<br/>semantic/keyword/hybrid]
        C4[Watch Service<br/>file change detection]
    end

    subgraph "Niveau 3: System 1 Features"
        S1[Encoder<br/>ONNX/Multimodal]
        S2[Noul Guardrail<br/>injection/OOD/null]
        S3[Choice Router<br/>context-aware selection]
        S4[Score Critiquer<br/>RAG relevance]
    end

    subgraph "Niveau 4: C++ Extensions (FFI)"
        F1[File Service<br/>list/read/write/delete]
        F2[Wiki Links<br/>extract/resolve]
        F3[Markdown Tables<br/>generate/format]
        F4[License Checker<br/>status]
    end

    subgraph "Niveau 5: External"
        E1[Model Files<br/>llama.cpp/ONNX]
        E2[Filesystem<br/>markdown notes]
        E3[MCP Clients<br/>OpenCode/Claude]
    end

    %% Flows
    I1 --> C1
    I2 --> C1 & C2 & C3
    I3 --> C4
    C1 --> S1 & S2 & S3 & S4
    C2 --> E1
    C3 --> E2
    I2 -.-> F1 & F2 & F3 & F4
    F1 --> E2
    F4 --> E1
    
